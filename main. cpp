#include <cstdlib>
#include <iostream>
#include <limits>
#include <random>
#include <string>

namespace {
constexpr int kMinimum = 1;
constexpr int kMaximum = 100;
constexpr int kMaximumAttempts = 7;

int readGuess(int attempt) {
    while (true) {
        std::cout << "Attempt " << attempt << "/" << kMaximumAttempts
                  << " - Enter a number between " << kMinimum << " and " << kMaximum
                  << ": ";
        
        int guess;
        if (std::cin >> guess) {
            if (guess >= kMinimum && guess <= kMaximum) {
                return guess;
            }
            std::cout << "Please enter a number within the valid range.\n";
        } else if (std::cin.eof()) {
            std::cout << "\nInput ended. Thanks for playing!\n";
            std::exit(0);
        } else {
            std::cout << "Invalid input. Please enter a whole number.\n";
            std::cin.clear();
            std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
        }
    }
}

void playRound(std::mt19937& generator) {
    std::uniform_int_distribution<int> distribution(kMinimum, kMaximum);
    const int secretNumber = distribution(generator);

    std::cout << "\nI picked a number between " << kMinimum << " and " << kMaximum
              << ". Can you guess it in " << kMaximumAttempts << " attempts?\n";

    for (int attempt = 1; attempt <= kMaximumAttempts; ++attempt) {
        const int guess = readGuess(attempt);

        if (guess == secretNumber) {
            std::cout << "Correct! You guessed it in " << attempt
                      << (attempt == 1 ? " attempt.\n" : " attempts.\n");
            return;
        }

        if (guess < secretNumber) {
            std::cout << "Too low! Try a higher number.\n";
        } else {
            std::cout << "Too high! Try a lower number.\n";
        }
    }

    std::cout << "Out of tries! The correct number was " << secretNumber << ".\n";
}

bool playAgain() {
    while (true) {
        std::cout << "Do you want to play again? (y/n): ";
        std::string answer;
        if (!(std::cin >> answer)) {
            return false;
        }

        if (answer == "y" || answer == "Y" || answer == "yes" || answer == "YES") {
            return true;
        }
        if (answer == "n" || answer == "N" || answer == "no" || answer == "NO") {
            return false;
        }

        std::cout << "Please enter 'y' for yes or 'n' for no.\n";
    }
}
} // namespace

int main() {
    std::random_device randomDevice;
    std::mt19937 generator(randomDevice());

    std::cout << "====================================\n";
    std::cout << "       Number Guessing Game\n";
    std::cout << "====================================\n";

    do {
        playRound(generator);
    } while (playAgain());

    std::cout << "Thanks for playing! Goodbye.\n";
    return 0;
}